<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen configuration -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- White background matching the Dart splash -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <!-- MedGuard branded icon -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <!-- No branding image to keep it clean -->
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
